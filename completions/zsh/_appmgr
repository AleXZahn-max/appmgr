(( $+functions[_appmgr_commands] )) ||
_appmgr_commands() {
    local commands; commands=(
'install:Install application locally, from GitHub (owner/repo\[@tag\]), or search' \
'search:Search GitHub repositories for applications' \
'link:Link an installed application to a GitHub repository for updates' \
'upgrade:Check and upgrade packages from GitHub Releases' \
'remove:Remove an installed application' \
'list:List installed applications' \
'info:Display details about a package or file' \
'doctor:Check system health, FUSE, and broken symlinks' \
'run:Launch an installed application' \
'env:Manage custom environment variables for an application' \
'args:Manage persistent launch flags for an application' \
'pin:Freeze an application version to skip general upgrades' \
'unpin:Unfreeze an application version to allow updates' \
'rollback:Restore previous version of an application from cache' \
'clean:Clean rollback backups and temporary cache' \
'export:Export installed applications to a JSON manifest' \
'import:Install applications from a JSON manifest' \
'update-db:Refresh desktop database and icon theme caches' \
'self-update:Update appmgr itself to the latest version' \
'completions:Generate shell completions (bash, zsh, fish)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'appmgr commands' commands "$@"
}
