#compdef appmgr

autoload -U is-at-least

_appmgr() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_appmgr_commands" \
"*::: :->appmgr" \
&& ret=0
    case $state in
    (appmgr)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:appmgr-command-$line[1]:"
        case $line[1] in
            (install)
_arguments "${_arguments_options[@]}" : \
'--repo=[Associate package with GitHub repository (owner/repo)]:REPO:_default' \
'--prefer=[Preferred asset format]:PREFER:(appimage deb tar zip bin)' \
'-f[Force overwrite existing installation]' \
'--force[Force overwrite existing installation]' \
'-y[Assume yes to prompts]' \
'--yes[Assume yes to prompts]' \
'--pre[Allow pre-release versions]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':package -- Path to package, GitHub target (owner/repo\[@tag\]), or search query:_default' \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':query -- Application name or search query:_default' \
&& ret=0
;;
(link)
_arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':app -- Installed application name or ID:_default' \
':repo -- GitHub repository (owner/repo or URL):_default' \
&& ret=0
;;
(upgrade)
_arguments "${_arguments_options[@]}" : \
'--prefer=[Preferred asset format]:PREFER:(appimage deb tar zip bin)' \
'-c[Check for available updates without installing]' \
'--check[Check for available updates without installing]' \
'-y[Assume yes to prompts]' \
'--yes[Assume yes to prompts]' \
'-f[Force upgrade even if pinned]' \
'--force[Force upgrade even if pinned]' \
'--pre[Include pre-releases in update check]' \
'--json[Output machine-readable JSON]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
'::app -- Specific application to upgrade (optional):_default' \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
'-y[Assume yes to prompts]' \
'--yes[Assume yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':package -- Name or ID of installed application:_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-t+[Filter by package format]:FILTER_TYPE:_default' \
'--type=[Filter by package format]:FILTER_TYPE:_default' \
'--json[Output machine-readable JSON]' \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(info)
_arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':target -- Package ID or file path to inspect:_default' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(run)
_arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':app -- Application name or ID:_default' \
'*::args -- Arguments passed to application:_default' \
&& ret=0
;;
(env)
_arguments "${_arguments_options[@]}" : \
'--unset=[Unset an environment variable]:UNSET:_default' \
'--list[List configured environment variables]' \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':app -- Application name or ID:_default' \
'*::pairs -- Variable pairs to set (e.g. KEY=VALUE):_default' \
&& ret=0
;;
(args)
_arguments "${_arguments_options[@]}" : \
'--clear[Clear all persistent launch flags]' \
'--list[List configured launch flags]' \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':app -- Application name or ID:_default' \
'*::cli_args -- Persistent flags to pass:_default' \
&& ret=0
;;
(pin)
_arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':app -- Application name or ID:_default' \
&& ret=0
;;
(unpin)
_arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':app -- Application name or ID:_default' \
&& ret=0
;;
(rollback)
_arguments "${_arguments_options[@]}" : \
'-y[Assume yes to prompt]' \
'--yes[Assume yes to prompt]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':app -- Application name or ID:_default' \
&& ret=0
;;
(clean)
_arguments "${_arguments_options[@]}" : \
'-y[Assume yes to prompt]' \
'--yes[Assume yes to prompt]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(export)
_arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
'::file -- Destination file (default\: appmgr-manifest.json):_default' \
&& ret=0
;;
(import)
_arguments "${_arguments_options[@]}" : \
'-y[Assume yes to all prompts]' \
'--yes[Assume yes to all prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to manifest JSON file:_default' \
&& ret=0
;;
(update-db)
_arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(self-update)
_arguments "${_arguments_options[@]}" : \
'-c[Check for available appmgr updates without installing]' \
'--check[Check for available appmgr updates without installing]' \
'--pre[Allow pre-release versions]' \
'-y[Assume yes to prompt]' \
'--yes[Assume yes to prompt]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'-y[Automatic yes to prompts]' \
'--yes[Automatic yes to prompts]' \
'--system[Force system-wide installation mode (/opt, /usr/local)]' \
'--user[Force user-level rootless mode (~/.local)]' \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completions for:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_appmgr__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:appmgr-help-command-$line[1]:"
        case $line[1] in
            (install)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(link)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(upgrade)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
