_appmgr_commands() {
    local commands; commands=(
'install:Install application locally, from GitHub (owner/repo\[@tag\]), or search' \
'search:Search package sources and online registries for applications' \
'update:Synchronize package databases from configured sources' \
'repo:Manage software sources and repositories in sources.list' \
'source:Validate and test source definitions (Schema v2)' \
'pkg:Maintainer tools for recipe creation, linting, and testing' \
'link:Link an installed application to a GitHub repository for updates' \
'upgrade:Check and upgrade packages from GitHub Releases and registries' \
'remove:Remove an installed application' \
